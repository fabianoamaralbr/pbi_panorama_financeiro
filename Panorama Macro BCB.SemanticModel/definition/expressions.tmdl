expression UrlBaseYahoo = "https://query1.finance.yahoo.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b1a7e0c2-2001-4aaa-8bbb-000000000008

	annotation PBI_ResultType = Text

expression fnYahooProventos =
		let
		    fnYahooProventos = (ticker as text) as table =>
		        let
		            resp = Web.Contents(
		                UrlBaseYahoo,
		                [
		                    RelativePath = "v8/finance/chart/" & ticker & ".SA",
		                    Query = [range = "10y", interval = "1d", events = "div"],
		                    Headers = [#"User-Agent" = "Mozilla/5.0"]
		                ]
		            ),
		            json = try Json.Document(resp) otherwise null,
		            resultado = if json = null then null else try json[chart][result]{0} otherwise null,
		            divsRec = if resultado = null then null else try resultado[events][dividends] otherwise null,
		            vazio = #table(type table [ticker = text, data_pagamento = date, valor = number, tipo = text], {}),
		            tbl =
		                if divsRec = null then
		                    vazio
		                else
		                    let
		                        lista = Record.FieldValues(divsRec),
		                        recs = Table.FromRecords(lista),
		                        comTicker = Table.AddColumn(recs, "ticker", each ticker, type text),
		                        comData = Table.AddColumn(comTicker, "data_pagamento", each try Date.From(#datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, [date])) otherwise null, type date),
		                        comTipo = Table.AddColumn(comData, "tipo", each "Provento", type text),
		                        ren = Table.RenameColumns(comTipo, {{"amount", "valor"}}),
		                        sel = Table.SelectColumns(ren, {"ticker", "data_pagamento", "valor", "tipo"}),
		                        tipos = Table.TransformColumnTypes(sel, {{"valor", type number}}),
		                        semNulos = Table.SelectRows(tipos, each [data_pagamento] <> null and [valor] <> null)
		                    in
		                        semNulos
		        in
		            tbl
		in
		    fnYahooProventos
	lineageTag: b1a7e0c2-2001-4aaa-8bbb-000000000009

	annotation PBI_ResultType = Function

expression fnBrapiQuote =
		let
		    fnBrapiQuote = (ticker as text) as table =>
		        let
		            resp = Web.Contents(
		                UrlBaseBrapi,
		                [
		                    RelativePath = "api/quote/" & ticker,
		                    Query = [token = BrapiToken]
		                ]
		            ),
		            json = try Json.Document(resp) otherwise null,
		            r = if json = null then null else try json[results]{0} otherwise null,
		            linha = [
		                ticker = ticker,
		                nome = if r = null then null else try r[longName] otherwise (try r[shortName] otherwise null),
		                preco_atual = if r = null then null else try r[regularMarketPrice] otherwise null,
		                pl = if r = null then null else try r[priceEarnings] otherwise null,
		                min_52s = if r = null then null else try r[fiftyTwoWeekLow] otherwise null,
		                max_52s = if r = null then null else try r[fiftyTwoWeekHigh] otherwise null
		            ],
		            tbl = Table.FromRecords({linha})
		        in
		            tbl
		in
		    fnBrapiQuote
	lineageTag: b1a7e0c2-2001-4aaa-8bbb-000000000010

	annotation PBI_ResultType = Function

