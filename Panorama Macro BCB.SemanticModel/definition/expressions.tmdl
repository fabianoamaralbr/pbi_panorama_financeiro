expression UrlBaseBCB = "https://api.bcb.gov.br" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b1a7e0c2-2001-4aaa-8bbb-000000000001

	annotation PBI_ResultType = Text

